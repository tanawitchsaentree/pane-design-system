{
  "name": "pane-react",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "description": "Pane, spatial glass React components. One install and one import: import 'pane-react/all.css'.",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "import": "./dist/node/index.js",
        "require": "./dist/index.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./all.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/all.css"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/tokens/tokens.css"
    },
    "./tokens/core.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/tokens/core.css"
    },
    "./tokens/colour.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/tokens/colour.css"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "default": "./dist/tokens/tokens.mjs"
    },
    "./tokens.json": "./dist/tokens/tokens.json",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/types/components/*/index.d.ts",
      "node": "./dist/node/components/*/index.js",
      "import": "./dist/components/*/index.js"
    },
    "./tokens/brands/*": {
      "style": "./dist/tokens/brands/*.css",
      "default": "./dist/tokens/brands/*.css"
    },
    "./tokens/brands.json": "./dist/tokens/brands/brands.json",
    "./skill": "./skill/SKILL.md"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "(test ! -f ../../tooling/kiln/i18n-lint.mjs || node ../../tooling/kiln/i18n-lint.mjs) && vite build && PANE_NODE=1 vite build && rm -rf dist/node/*.css dist/node/css && vite build -c vite.cjs.config.ts && rm -f dist/cjs-unused.css && tsc -p tsconfig.build.json && node ../../tooling/bundle-tokens.mjs && cp ../tokens/build/css/core.css ../tokens/build/css/colour.css dist/tokens/ && mkdir -p dist/tokens/brands && cp ../tokens/build/css/brands/* dist/tokens/brands/ && node ../../tooling/pane-knowledge.mjs",
    "typecheck": "tsc --noEmit -p .",
    "barrel:check": "node ../../tooling/generate-barrel.mjs --check",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1",
    "@radix-ui/react-checkbox": "^1",
    "@radix-ui/react-context-menu": "^2",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-radio-group": "^1",
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-slider": "^1",
    "@radix-ui/react-switch": "^1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1",
    "@radix-ui/react-toggle-group": "^1",
    "@radix-ui/react-tooltip": "^1"
  },
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "styles.css.d.ts",
    "bin",
    "skill"
  ],
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pane-tokens": "workspace:^",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "bin": {
    "pane-mesh": "./bin/pane-mesh.mjs",
    "pane-pwa": "./bin/pane-pwa.mjs",
    "pane-mcp": "./bin/pane-mcp.mjs",
    "pane-theme": "bin/pane-theme.mjs"
  }
}
