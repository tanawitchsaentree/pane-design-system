{
  "name": "pane-react",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Pane — spatial glass React components. Load pane-tokens/css and pane-react/styles.css once.",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "barrel:check": "node ../../tooling/generate-barrel.mjs --check",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-slider": "^1",
    "@radix-ui/react-tabs": "^1.2.1",
    "pane-tokens": "workspace:^"
  },
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "styles.css.d.ts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
