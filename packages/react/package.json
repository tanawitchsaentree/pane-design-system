{
  "name": "dial-react",
  "version": "0.1.0",
  "description": "React component library for Dial — presentational primitives styled with dial-tokens CSS variables (D-011).",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:no-hardcode": "cd ../.. && node tooling/no-hardcode-lint.mjs",
    "barrel:check": "node ../../tooling/generate-barrel.mjs --check",
    "story:check": "node ../../tooling/story-title-check.mjs",
    "doc:check": "node ../../tooling/doc-count-check.mjs",
    "pack-verify": "node ../../tooling/pack-verify.mjs",
    "prepublishOnly": "pnpm run barrel:check && pnpm run story:check && pnpm run doc:check && pnpm run lint:no-hardcode && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack-verify && pnpm run smoke:import",
    "smoke:import": "cd ../.. && node tooling/smoke-import.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-aria/interactions": "3.22.5",
    "@react-aria/listbox": "3.13.6",
    "@react-stately/collections": "3.12.0",
    "@react-stately/list": "3.11.1",
    "@react-types/shared": "3.26.0"
  },
  "devDependencies": {
    "@storybook/react": "^8.4.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dial-tokens": "workspace:*",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
