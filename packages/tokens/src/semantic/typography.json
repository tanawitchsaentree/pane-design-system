{
  "text": {
    "$description": "D-005 — composite typography tokens (size+lineHeight+weight+family). Single font family for heading and body per D-005 (hierarchy comes from position/size of blocks, not font per D-001).",
    "body": {
      "xs": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.xs}", "fontWeight": "{fontWeight.regular}", "lineHeight": "{lineHeight.body}", "letterSpacing": "{letterSpacing.normal}" } },
      "sm": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.sm}", "fontWeight": "{fontWeight.regular}", "lineHeight": "{lineHeight.body}", "letterSpacing": "{letterSpacing.normal}" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.md}", "fontWeight": "{fontWeight.regular}", "lineHeight": "{lineHeight.body}", "letterSpacing": "{letterSpacing.normal}" } },
      "lg": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.lg}", "fontWeight": "{fontWeight.regular}", "lineHeight": "{lineHeight.body}", "letterSpacing": "{letterSpacing.normal}" } }
    },
    "heading": {
      "sm": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.lg}", "fontWeight": "{fontWeight.semibold}", "lineHeight": "{lineHeight.heading}", "letterSpacing": "{letterSpacing.normal}" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.xl}", "fontWeight": "{fontWeight.semibold}", "lineHeight": "{lineHeight.heading}", "letterSpacing": "{letterSpacing.normal}" } },
      "lg": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.2xl}", "fontWeight": "{fontWeight.semibold}", "lineHeight": "{lineHeight.heading}", "letterSpacing": "{letterSpacing.normal}" } },
      "xl": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.3xl}", "fontWeight": "{fontWeight.bold}", "lineHeight": "{lineHeight.heading}", "letterSpacing": "{letterSpacing.normal}" } },
      "2xl": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.4xl}", "fontWeight": "{fontWeight.bold}", "lineHeight": "{lineHeight.heading}", "letterSpacing": "{letterSpacing.normal}" } },
      "3xl": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.sans}", "fontSize": "{fontSize.5xl}", "fontWeight": "{fontWeight.bold}", "lineHeight": "{lineHeight.heading}", "letterSpacing": "{letterSpacing.normal}" } }
    },
    "code": {
      "sm": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.mono}", "fontSize": "{fontSize.sm}", "fontWeight": "{fontWeight.regular}", "lineHeight": "{lineHeight.body}", "letterSpacing": "{letterSpacing.normal}" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{fontFamily.mono}", "fontSize": "{fontSize.md}", "fontWeight": "{fontWeight.regular}", "lineHeight": "{lineHeight.body}", "letterSpacing": "{letterSpacing.normal}" } }
    }
  }
}
