{
  "$description": "Dark theme semantic layer. D-008 rule 5 (braun-flat.md): dark mode uses the surface-lightness ladder instead of shadow, higher = lighter/more elevated, exactly mirroring light.json but inverted. Same accent-scarcity + hairline-not-shadow rules apply (D-001, D-008).",
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "{color.neutral.950}" },
      "inset": { "$type": "color", "$value": "{color.neutral.975}" },
      "raised": { "$type": "color", "$value": "{color.neutral.900}" },
      "overlay": { "$type": "color", "$value": "{color.neutral.800}" }
    },
    "text": {
      "default": { "$type": "color", "$value": "{color.neutral.50}" },
      "subtle": { "$type": "color", "$value": "{color.neutral.300}" },
      "disabled": { "$type": "color", "$value": "{color.neutral.600}" },
      "inverse": { "$type": "color", "$value": "{color.neutral.900}" },
      "onPrimary": { "$type": "color", "$value": "{color.neutral.950}" },
      "onDanger": { "$type": "color", "$value": "{color.neutral.950}" },
      "onSuccess": { "$type": "color", "$value": "{color.base.white}" },
      "onWarning": { "$type": "color", "$value": "{color.base.white}" },
      "onInfo": { "$type": "color", "$value": "{color.base.white}" },
      "onRoleSolid": { "$type": "color", "$value": "{color.neutral.950}" }
    },
    "border": {
      "$description": "D-014: interactive added as the dark-mode mirror of light.json's — reserved for borders that ARE the boundary of a focusable/interactive control (e.g. Button outline), needs 3:1 UI-component contrast which hairline (neutral.800) does not clear against dark canvas.",
      "hairline": { "$type": "color", "$value": "{color.neutral.800}" },
      "hairlineStrong": { "$type": "color", "$value": "{color.neutral.600}" },
      "interactive": { "$type": "color", "$value": "{color.neutral.500}" },
      "subtle": { "$type": "color", "$value": "{color.neutral.900}" },
      "focus": { "$type": "color", "$value": "{color.brand.400}" },
      "danger": { "$type": "color", "$value": "{color.danger.400}" }
    },
    "action": {
      "$description": "Dark mode swaps to a lighter brand step (400) so on-fill text can stay dark and legible (D-006 accent-scarcity rule still applies — one primary action per view). hover/active step further up the light-ward direction.",
      "primary": {
        "default": { "$type": "color", "$value": "{color.brand.400}" },
        "hover": { "$type": "color", "$value": "{color.brand.300}" },
        "active": { "$type": "color", "$value": "{color.brand.200}" },
        "disabled": { "$type": "color", "$value": "{color.neutral.700}" }
      },
      "neutral": {
        "default": { "$type": "color", "$value": "{color.neutral.800}" },
        "hover": { "$type": "color", "$value": "{color.neutral.700}" },
        "active": { "$type": "color", "$value": "{color.neutral.600}" },
        "disabled": { "$type": "color", "$value": "{color.neutral.900}" }
      },
      "danger": {
        "$description": "D-014: default moved 700->400 — danger.700 measured only 2.13:1 as TEXT/border on dark bg.canvas (fails AA); danger.400 mirrors the same lighter-in-dark pattern already used by action.primary (brand.600->400) and measures 6.08:1.",
        "default": { "$type": "color", "$value": "{color.danger.400}" },
        "hover": { "$type": "color", "$value": "{color.danger.300}" },
        "active": { "$type": "color", "$value": "{color.danger.200}" },
        "disabled": { "$type": "color", "$value": "{color.neutral.700}" }
      }
    },
    "feedback": {
      "success": { "$type": "color", "$value": "{color.success.400}" },
      "warning": { "$type": "color", "$value": "{color.warning.400}" },
      "danger": { "$type": "color", "$value": "{color.danger.400}" },
      "info": { "$type": "color", "$value": "{color.info.400}" }
    },
    "role": {
      "$description": "Wave 2 (D-013) addition — dark-theme mirror of light.json's Badge role tokens. solid steps move lighter (400) to read against a dark canvas per the same pattern as color.action.primary above; subtleBg uses a dark, low-chroma step instead of light tint so it still reads as 'quiet fill' rather than 'glow'.",
      "neutral": {
        "solid": { "$type": "color", "$value": "{color.neutral.300}" },
        "subtleBg": { "$type": "color", "$value": "{color.neutral.800}" },
        "subtleText": { "$type": "color", "$value": "{color.neutral.200}" }
      },
      "brand": {
        "solid": { "$type": "color", "$value": "{color.brand.400}" },
        "subtleBg": { "$type": "color", "$value": "{color.brand.900}" },
        "subtleText": { "$type": "color", "$value": "{color.brand.200}" }
      },
      "success": {
        "solid": { "$type": "color", "$value": "{color.success.400}" },
        "subtleBg": { "$type": "color", "$value": "{color.success.900}" },
        "subtleText": { "$type": "color", "$value": "{color.success.200}" }
      },
      "warning": {
        "solid": { "$type": "color", "$value": "{color.warning.400}" },
        "subtleBg": { "$type": "color", "$value": "{color.warning.900}" },
        "subtleText": { "$type": "color", "$value": "{color.warning.200}" }
      },
      "danger": {
        "solid": { "$type": "color", "$value": "{color.danger.400}" },
        "subtleBg": { "$type": "color", "$value": "{color.danger.900}" },
        "subtleText": { "$type": "color", "$value": "{color.danger.200}" }
      },
      "info": {
        "solid": { "$type": "color", "$value": "{color.info.400}" },
        "subtleBg": { "$type": "color", "$value": "{color.info.900}" },
        "subtleText": { "$type": "color", "$value": "{color.info.200}" }
      }
    },
    "overlay": {
      "$description": "Dark theme uses white alpha (lightens on top of dark fill) — mirrors light.json's black alpha.",
      "hover": { "$type": "color", "$value": "#FFFFFF0F" },
      "pressed": { "$type": "color", "$value": "#FFFFFF1F" },
      "scrim": { "$type": "color", "$value": "#00000099" }
    }
  },
  "shadow": {
    "$description": "elevation.* — D-008 rule 5, UNCHANGED — dark mode still declares elevation tokens for API symmetry, but in practice the surface-lightness ladder does the visual work; shadow stays reserved for modal/popover/toast/dropdown only. raised.*/inset.* — NEW under D-029 — same structural-depth role as light.json's, using black at a lower alpha (a shadow tinted with light.json's ink color would barely read against an already-dark canvas) — per FORM.md, the fill-lightness shift is the PRIMARY cue in dark theme (the shadow itself is secondary/subtle here, same pattern already established for elevation.* above).",
    "elevation": {
      "sm": { "$type": "shadow", "$value": { "color": "#0000004D", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } },
      "md": {
        "$type": "shadow",
        "$value": [
          { "color": "#00000059", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px" },
          { "color": "#0000004D", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
        ]
      },
      "lg": {
        "$type": "shadow",
        "$value": [
          { "color": "#00000066", "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "-4px" },
          { "color": "#0000004D", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" }
        ]
      }
    },
    "raised": {
      "sm": { "$type": "shadow", "$value": { "color": "#00000040", "offsetX": "1px", "offsetY": "2px", "blur": "3px", "spread": "0px" } },
      "md": { "$type": "shadow", "$value": { "color": "#00000052", "offsetX": "1px", "offsetY": "3px", "blur": "5px", "spread": "0px" } }
    },
    "inset": {
      "sm": { "$type": "shadow", "$value": { "type": "inset", "color": "#00000040", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
      "md": { "$type": "shadow", "$value": { "type": "inset", "color": "#00000052", "offsetX": "0px", "offsetY": "2px", "blur": "3px", "spread": "0px" } }
    }
  },
  "focusRing": {
    "color": { "$type": "color", "$value": "{color.brand.400}" },
    "width": { "$type": "dimension", "$value": "{borderWidth.thick}" },
    "offset": { "$type": "dimension", "$value": "2px" }
  }
}
