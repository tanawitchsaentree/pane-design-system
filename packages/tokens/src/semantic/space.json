{
  "space": {
    "$description": "D-003 — spacing scale (gaps/padding/margins ONLY, never widths/heights of things — that's size.*). Base unit 8px. Numeric steps + semantic inset/stack/inline aliases. Exact numeric→alias mapping (which step = sm/md/lg) is not pinned by D-003 itself (it only fixed the raw scale + confirmed the alias trio exists) — mapping below is a derived, reasonable default following common density conventions, not a literal decision value.",
    "0": { "$type": "dimension", "$value": "{dimension.0}" },
    "100": { "$type": "dimension", "$value": "{dimension.8}" },
    "200": { "$type": "dimension", "$value": "{dimension.16}" },
    "300": { "$type": "dimension", "$value": "{dimension.24}" },
    "400": { "$type": "dimension", "$value": "{dimension.32}" },
    "500": { "$type": "dimension", "$value": "{dimension.40}" },
    "600": { "$type": "dimension", "$value": "{dimension.48}" },
    "700": { "$type": "dimension", "$value": "{dimension.64}" },
    "800": { "$type": "dimension", "$value": "{dimension.80}" },
    "900": { "$type": "dimension", "$value": "{dimension.96}" },
    "1000": { "$type": "dimension", "$value": "{dimension.128}" },
    "1100": { "$type": "dimension", "$value": "{dimension.160}" },
    "inset": {
      "$description": "Padding inside a container.",
      "sm": { "$type": "dimension", "$value": "{space.200}" },
      "md": { "$type": "dimension", "$value": "{space.300}" },
      "lg": { "$type": "dimension", "$value": "{space.400}" }
    },
    "stack": {
      "$description": "Vertical gap between stacked blocks.",
      "sm": { "$type": "dimension", "$value": "{space.200}" },
      "md": { "$type": "dimension", "$value": "{space.400}" },
      "lg": { "$type": "dimension", "$value": "{space.600}" }
    },
    "inline": {
      "$description": "Horizontal gap between inline items.",
      "sm": { "$type": "dimension", "$value": "{space.100}" },
      "md": { "$type": "dimension", "$value": "{space.200}" },
      "lg": { "$type": "dimension", "$value": "{space.300}" }
    }
  }
}
