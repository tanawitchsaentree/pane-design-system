{
  "size": {
    "$description": "D-004 — size of the thing itself (icon/avatar/control), a namespace strictly separate from space.* (D-003) even though it may alias the same dimension primitives. This axis must NOT change when density mode changes (blueprint §4.2 rule).",
    "icon": {
      "sm": { "$type": "dimension", "$value": "{dimension.16}" },
      "md": { "$type": "dimension", "$value": "{dimension.20}" },
      "lg": { "$type": "dimension", "$value": "{dimension.24}" },
      "xl": { "$type": "dimension", "$value": "{dimension.32}" }
    },
    "avatar": {
      "xs": { "$type": "dimension", "$value": "{dimension.24}" },
      "sm": { "$type": "dimension", "$value": "{dimension.32}" },
      "md": { "$type": "dimension", "$value": "{dimension.40}" },
      "lg": { "$type": "dimension", "$value": "{dimension.48}" },
      "xl": { "$type": "dimension", "$value": "{dimension.64}" },
      "2xl": { "$type": "dimension", "$value": "{dimension.96}" }
    },
    "control": {
      "$description": "T-shirt control height, thick per D-004 (dial/knob-inspired proportions, +8px over blueprint default sm32/md40/lg48/xl56).",
      "sm": { "$type": "dimension", "$value": "{dimension.40}" },
      "md": { "$type": "dimension", "$value": "{dimension.48}" },
      "lg": { "$type": "dimension", "$value": "{dimension.56}" },
      "xl": { "$type": "dimension", "$value": "{dimension.64}" }
    }
  }
}
