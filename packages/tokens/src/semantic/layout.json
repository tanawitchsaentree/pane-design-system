{
  "$description": "D-007 — grid/breakpoint semantics + container max-widths per breakpoint. Gutter aliases space.300 (24px) exactly as D-007 specifies.",
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "{breakpointRaw.sm}" },
    "md": { "$type": "dimension", "$value": "{breakpointRaw.md}" },
    "lg": { "$type": "dimension", "$value": "{breakpointRaw.lg}" },
    "xl": { "$type": "dimension", "$value": "{breakpointRaw.xl}" },
    "2xl": { "$type": "dimension", "$value": "{breakpointRaw.2xl}" }
  },
  "grid": {
    "columns": { "$type": "number", "$value": "{gridRaw.columns}" },
    "gutter": { "$type": "dimension", "$value": "{space.300}" }
  },
  "container": {
    "$description": "Standard max-width per breakpoint — blueprint default, no decision pins exact numbers so these mirror the breakpoint scale with a small margin allowance.",
    "sm": { "$type": "dimension", "$value": "{breakpointRaw.sm}" },
    "md": { "$type": "dimension", "$value": "{breakpointRaw.md}" },
    "lg": { "$type": "dimension", "$value": "{breakpointRaw.lg}" },
    "xl": { "$type": "dimension", "$value": "{breakpointRaw.xl}" },
    "2xl": { "$type": "dimension", "$value": "{breakpointRaw.2xl}" }
  }
}
