{
  "$description": "D-009 — motion semantics, theme-independent (same in light/dark). Composite transition tokens combine duration + easing for the interactions QA checks for (state changes must use fill/border, but the transition speed of that change lives here).",
  "transition": {
    "fast": { "$type": "transition", "$value": { "duration": "{duration.fast}", "delay": "0ms", "timingFunction": "{cubicBezier.standard}" } },
    "base": { "$type": "transition", "$value": { "duration": "{duration.base}", "delay": "0ms", "timingFunction": "{cubicBezier.standard}" } },
    "slow": { "$type": "transition", "$value": { "duration": "{duration.slow}", "delay": "0ms", "timingFunction": "{cubicBezier.standard}" } },
    "enter": { "$type": "transition", "$value": { "duration": "{duration.base}", "delay": "0ms", "timingFunction": "{cubicBezier.decelerate}" } },
    "exit": { "$type": "transition", "$value": { "duration": "{duration.fast}", "delay": "0ms", "timingFunction": "{cubicBezier.accelerate}" } }
  }
}
