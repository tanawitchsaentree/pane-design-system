{
  "card": {
    "bg": {
      "$type": "color",
      "$value": "{surface.glass}"
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "fg-muted": {
      "$type": "color",
      "$value": "{text.secondary}"
    },
    "blur": {
      "$type": "dimension",
      "$value": "{glass.blur}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.panel}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{gap.inset}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.xl}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{elevation.float}"
    },
    "rim-hi": {
      "$type": "color",
      "$value": "{line.rim-hi}"
    },
    "rim-mid": {
      "$type": "color",
      "$value": "{line.rim-mid}"
    },
    "rim-lo": {
      "$type": "color",
      "$value": "{line.rim-lo}"
    },
    "divider": {
      "$type": "color",
      "$value": "{line.divider}"
    },
    "rim-width": {
      "$type": "dimension",
      "$value": "{width.hairline}"
    },
    "inner-radius": {
      "$type": "dimension",
      "$value": "{corner.inner}"
    },
    "media-radius": {
      "$type": "dimension",
      "$value": "{corner.media}"
    },
    "cover-hi": {
      "$type": "color",
      "$value": "{surface.placeholder-hi}"
    },
    "cover-lo": {
      "$type": "color",
      "$value": "{surface.placeholder-lo}"
    },
    "brightness": {
      "$type": "number",
      "$value": "{glass.brightness}"
    },
    "sheen-top": {
      "$type": "color",
      "$value": "{surface.sheen-top}"
    },
    "sheen-bottom": {
      "$type": "color",
      "$value": "{surface.sheen-bottom}"
    },
    "text-halo": {
      "$type": "shadow",
      "$value": "{elevation.halo}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "the card is the pane itself, so its glass fill, sheen, rim, float shadow, panel corner and inset padding all map from the material and depth roles and every pane is the same object"
      }
    },
    "level1": {
      "$type": "color",
      "$value": "{level.1}"
    },
    "level2": {
      "$type": "color",
      "$value": "{level.2}"
    },
    "level3": {
      "$type": "color",
      "$value": "{level.3}"
    },
    "level4": {
      "$type": "color",
      "$value": "{level.4}"
    },
    "shadow-1": {
      "$type": "shadow",
      "$value": "{level-shadow.1}"
    },
    "shadow-2": {
      "$type": "shadow",
      "$value": "{level-shadow.2}"
    },
    "shadow-3": {
      "$type": "shadow",
      "$value": "{level-shadow.3}"
    },
    "shadow-4": {
      "$type": "shadow",
      "$value": "{level-shadow.4}"
    },
    "edge": {
      "$type": "shadow",
      "$value": "{level-shadow.edge}"
    },
    "streak": {
      "$type": "color",
      "$value": "{level.streak}"
    },
    "scrim": {
      "$type": "color",
      "$value": "{level.scrim}"
    }
  },
  "avatar": {
    "size-sm": {
      "$type": "dimension",
      "$value": "{control.avatar-sm}"
    },
    "size-md": {
      "$type": "dimension",
      "$value": "{control.avatar-md}"
    },
    "size-lg": {
      "$type": "dimension",
      "$value": "{control.avatar-lg}"
    },
    "fallback-bg": {
      "$type": "color",
      "$value": "{surface.light}"
    },
    "fallback-fg": {
      "$type": "color",
      "$value": "{text.on-light}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "a portrait behind a lens with the pane rim and a soft shadow under the large size; initials on the loud solid when there is no photo"
      }
    },
    "lens": {
      "$type": "shadow",
      "$value": "{elevation.portrait}"
    },
    "cast": {
      "$type": "shadow",
      "$value": "{elevation.cast}"
    }
  },
  "button": {
    "light-bg": {
      "$type": "color",
      "$value": "{action.loud-foot}"
    },
    "light-fg": {
      "$type": "color",
      "$value": "{text.on-light}"
    },
    "accent-bg": {
      "$type": "color",
      "$value": "{action.loud-foot}"
    },
    "accent-bg-hover": {
      "$type": "color",
      "$value": "{action.accent-hover}"
    },
    "accent-fg": {
      "$type": "color",
      "$value": "{text.on-accent}"
    },
    "glass-bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "glass-fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "height-sm": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "height-md": {
      "$type": "dimension",
      "$value": "{control.lg}"
    },
    "padding-sm": {
      "$type": "dimension",
      "$value": "{gap.xl}"
    },
    "padding-md": {
      "$type": "dimension",
      "$value": "{gap.inset}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{elevation.lift}"
    },
    "$extensions": {
      "kiln.why": {
        "p": [
          "P3",
          "P5"
        ],
        "why": "a button is a small pane, a sheet lit at its top and shaded at its foot, with the pane rim, a glint under the pointer and a shadow that is blue under the accent; loud, accent and quiet roles, all full pills"
      }
    },
    "accent-mid": {
      "$type": "color",
      "$value": "{action.accent-hover}"
    },
    "accent-foot": {
      "$type": "color",
      "$value": "{action.loud-foot}"
    },
    "gloss": {
      "$type": "color",
      "$value": "{action.gloss}"
    },
    "gloss-quiet": {
      "$type": "color",
      "$value": "{action.gloss-quiet}"
    },
    "gloss-solid": {
      "$type": "color",
      "$value": "{action.gloss-solid}"
    },
    "light-top": {
      "$type": "color",
      "$value": "{action.loud-top}"
    },
    "light-foot": {
      "$type": "color",
      "$value": "{action.foot-solid}"
    },
    "glint": {
      "$type": "color",
      "$value": "{action.glint}"
    },
    "glint-solid": {
      "$type": "color",
      "$value": "{action.glint-solid}"
    },
    "rim-hi": {
      "$type": "color",
      "$value": "{line.rim-hi}"
    },
    "rim-mid": {
      "$type": "color",
      "$value": "{line.rim-mid}"
    },
    "rim-lo": {
      "$type": "color",
      "$value": "{line.rim-lo}"
    },
    "cast": {
      "$type": "shadow",
      "$value": "{elevation.cast}"
    },
    "cast-press": {
      "$type": "shadow",
      "$value": "{elevation.cast-press}"
    },
    "accent-cast": {
      "$type": "shadow",
      "$value": "{level-shadow.bloom}"
    },
    "accent-cast-hover": {
      "$type": "shadow",
      "$value": "{level-shadow.bloom}"
    },
    "accent-cast-press": {
      "$type": "shadow",
      "$value": "{elevation.cast-press}"
    },
    "hit": {
      "$type": "dimension",
      "$value": "{layout.touch}"
    },
    "accent-top": {
      "$type": "color",
      "$value": "{action.loud-top}"
    },
    "glass-top": {
      "$type": "color",
      "$value": "{level.sheen}"
    },
    "glass-foot": {
      "$type": "color",
      "$value": "{level.3}"
    },
    "glass-cast": {
      "$type": "shadow",
      "$value": "{level-shadow.2}"
    },
    "edge": {
      "$type": "shadow",
      "$value": "{level-shadow.edge}"
    },
    "streak": {
      "$type": "color",
      "$value": "{level.streak}"
    }
  },
  "icon-button": {
    "size": {
      "$type": "dimension",
      "$value": "{control.md}"
    },
    "size-sm": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "icon": {
      "$type": "dimension",
      "$value": "{control.icon-md}"
    },
    "glass-bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "ghost-fg": {
      "$type": "color",
      "$value": "{text.secondary}"
    },
    "blur": {
      "$type": "dimension",
      "$value": "{glass.blur-small}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "$extensions": {
      "kiln.why": {
        "p": [
          "P3",
          "P6"
        ],
        "why": "a small round pane with Button material (gloss, rim, pointer glint) and a 44px hit area around the small size"
      }
    },
    "hit": {
      "$type": "dimension",
      "$value": "{layout.touch}"
    },
    "gloss": {
      "$type": "color",
      "$value": "{action.gloss-quiet}"
    },
    "glint": {
      "$type": "color",
      "$value": "{action.glint}"
    },
    "rim-hi": {
      "$type": "color",
      "$value": "{line.rim-hi}"
    },
    "rim-mid": {
      "$type": "color",
      "$value": "{line.rim-mid}"
    },
    "rim-lo": {
      "$type": "color",
      "$value": "{line.rim-lo}"
    },
    "glass-top": {
      "$type": "color",
      "$value": "{level.sheen}"
    },
    "glass-foot": {
      "$type": "color",
      "$value": "{level.3}"
    },
    "cast": {
      "$type": "shadow",
      "$value": "{level-shadow.2}"
    },
    "edge": {
      "$type": "shadow",
      "$value": "{level-shadow.edge}"
    },
    "streak": {
      "$type": "color",
      "$value": "{level.streak}"
    },
    "loud-top": {
      "$type": "color",
      "$value": "{action.loud-top}"
    },
    "loud-foot": {
      "$type": "color",
      "$value": "{action.loud-foot}"
    },
    "loud-fg": {
      "$type": "color",
      "$value": "{text.on-light}"
    },
    "bloom": {
      "$type": "shadow",
      "$value": "{level-shadow.bloom}"
    }
  },
  "tabs": {
    "gap": {
      "$type": "dimension",
      "$value": "{gap.sm}"
    },
    "height": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "on-fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "$extensions": {
      "kiln.why": {
        "p": [
          "P1",
          "P3"
        ],
        "why": "a carved track holding the choices, the chosen tab the blue accent sheet resting in it (D-009 keeps the blue), with a 44px hit area on each tab"
      }
    },
    "hit": {
      "$type": "dimension",
      "$value": "{layout.touch}"
    },
    "track-bg": {
      "$type": "color",
      "$value": "{surface.well-deep}"
    },
    "carve": {
      "$type": "shadow",
      "$value": "{level-shadow.well}"
    },
    "inset": {
      "$type": "dimension",
      "$value": "{gap.xs}"
    },
    "on-foot": {
      "$type": "color",
      "$value": "{surface.chosen-foot}"
    },
    "on-cast": {
      "$type": "shadow",
      "$value": "{level-shadow.2}"
    },
    "off-fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "on-top": {
      "$type": "color",
      "$value": "{surface.chosen-top}"
    },
    "rim-hi": {
      "$type": "color",
      "$value": "{line.rim-hi}"
    },
    "rim-mid": {
      "$type": "color",
      "$value": "{line.rim-mid}"
    },
    "rim-lo": {
      "$type": "color",
      "$value": "{line.rim-lo}"
    },
    "streak": {
      "$type": "color",
      "$value": "{level.streak}"
    }
  },
  "tag": {
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{gap.xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "a label etched into the glass, so it cannot be mistaken for a button; uppercase micro type in the text colour"
      }
    },
    "bg": {
      "$type": "color",
      "$value": "{surface.carve}"
    },
    "etch": {
      "$type": "shadow",
      "$value": "{elevation.etch}"
    }
  },
  "focus-ring": {
    "color": {
      "$type": "color",
      "$value": "{focus.ring}"
    },
    "halo": {
      "$type": "color",
      "$value": "{focus.halo}"
    },
    "width": {
      "$type": "dimension",
      "$value": "{width.ring}"
    },
    "halo-width": {
      "$type": "dimension",
      "$value": "{width.halo}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P6",
        "why": "one ring for every component, 2px in the text colour and offset from the edge, with a halo of the opposite colour so focus shows on any backdrop"
      }
    }
  },
  "grid": {
    "columns": {
      "$type": "number",
      "$value": "{layout.columns}"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "{layout.gutter}"
    },
    "margin": {
      "$type": "dimension",
      "$value": "{layout.margin}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "grid columns, gutters and spans read from the layout roles, so panes on a page share one set of edges at every breakpoint"
      }
    }
  },
  "container": {
    "margin": {
      "$type": "dimension",
      "$value": "{layout.margin}"
    },
    "max-sm": {
      "$type": "dimension",
      "$value": "{layout.container-sm}"
    },
    "max-md": {
      "$type": "dimension",
      "$value": "{layout.container-md}"
    },
    "max-lg": {
      "$type": "dimension",
      "$value": "{layout.container-lg}"
    },
    "max-xl": {
      "$type": "dimension",
      "$value": "{layout.container-xl}"
    },
    "max-2xl": {
      "$type": "dimension",
      "$value": "{layout.container-2xl}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P7",
        "why": "container widths and margins cap how wide content grows, so reading lines and grids stay a comfortable size on large screens"
      }
    }
  },
  "stack": {
    "gap-xs": {
      "$type": "dimension",
      "$value": "{gap.xs}"
    },
    "gap-sm": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "gap-md": {
      "$type": "dimension",
      "$value": "{gap.2xl}"
    },
    "gap-lg": {
      "$type": "dimension",
      "$value": "{gap.3xl}"
    },
    "gap-xl": {
      "$type": "dimension",
      "$value": "{gap.section}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "stack gaps come from the named gap scale, so spacing inside a pane always stays smaller than the pane padding around it"
      }
    }
  },
  "badge": {
    "height": {
      "$type": "dimension",
      "$value": "{control.badge}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "dot": {
      "$type": "dimension",
      "$value": "{control.dot}"
    },
    "$extensions": {
      "kiln.why": {
        "p": [
          "P1",
          "P6"
        ],
        "why": "a status written on the glass, a glyph shape per tone in its mark colour and the word in the text colour, with no fill"
      }
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "neutral-mark": {
      "$type": "color",
      "$value": "{text.secondary}"
    },
    "info-mark": {
      "$type": "color",
      "$value": "{status.info-mark}"
    },
    "positive-mark": {
      "$type": "color",
      "$value": "{status.positive-mark}"
    },
    "warning-mark": {
      "$type": "color",
      "$value": "{status.warning-mark}"
    },
    "critical-mark": {
      "$type": "color",
      "$value": "{status.critical-mark}"
    },
    "glyph": {
      "$type": "dimension",
      "$value": "{control.icon-sm}"
    }
  },
  "chip": {
    "bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "on-fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "height": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.sm}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "icon": {
      "$type": "dimension",
      "$value": "{control.icon-sm}"
    },
    "$extensions": {
      "kiln.why": {
        "p": [
          "P5",
          "P4"
        ],
        "why": "a small glass pane to press; chosen is pressed into a carved recess with a check, so chosen chips add no loud marks"
      }
    },
    "hit": {
      "$type": "dimension",
      "$value": "{layout.touch}"
    },
    "rim-hi": {
      "$type": "color",
      "$value": "{line.rim-hi}"
    },
    "rim-mid": {
      "$type": "color",
      "$value": "{line.rim-mid}"
    },
    "rim-lo": {
      "$type": "color",
      "$value": "{line.rim-lo}"
    },
    "top": {
      "$type": "color",
      "$value": "{level.sheen}"
    },
    "foot": {
      "$type": "color",
      "$value": "{level.3}"
    },
    "cast": {
      "$type": "shadow",
      "$value": "{level-shadow.2}"
    },
    "on-top": {
      "$type": "color",
      "$value": "{surface.chosen-tint-top}"
    },
    "on-foot": {
      "$type": "color",
      "$value": "{surface.chosen-tint-foot}"
    },
    "on-cast": {
      "$type": "shadow",
      "$value": "{level-shadow.2}"
    },
    "edge": {
      "$type": "shadow",
      "$value": "{level-shadow.edge}"
    },
    "streak": {
      "$type": "color",
      "$value": "{level.streak}"
    }
  },
  "banner": {
    "$extensions": {
      "kiln.why": {
        "p": [
          "P3",
          "P1"
        ],
        "why": "a banner is a line written on the pane, so tone marks are glyph colours only, a hairline separates it from the content, and its spacing follows the pane"
      }
    },
    "mark-info": {
      "$type": "color",
      "$value": "{status.info-mark}"
    },
    "mark-positive": {
      "$type": "color",
      "$value": "{status.positive-mark}"
    },
    "mark-warning": {
      "$type": "color",
      "$value": "{status.warning-mark}"
    },
    "mark-critical": {
      "$type": "color",
      "$value": "{status.critical-mark}"
    },
    "glyph": {
      "$type": "dimension",
      "$value": "{control.icon-md}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "divider": {
      "$type": "color",
      "$value": "{line.divider}"
    },
    "dismiss": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "hit": {
      "$type": "dimension",
      "$value": "{layout.touch}"
    }
  },
  "select": {
    "trigger-bg": {
      "$type": "color",
      "$value": "{surface.carve}"
    },
    "trigger-fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "trigger-ring": {
      "$type": "color",
      "$value": "{line.ring}"
    },
    "height-sm": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "height-md": {
      "$type": "dimension",
      "$value": "{control.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "menu-bg": {
      "$type": "color",
      "$value": "{surface.raised}",
      "$description": "opaque: a list over glass must not let the scene read through the options"
    },
    "menu-ring": {
      "$type": "color",
      "$value": "{line.divider}"
    },
    "menu-radius": {
      "$type": "dimension",
      "$value": "{corner.inner}"
    },
    "menu-shadow": {
      "$type": "shadow",
      "$value": "{elevation.float}"
    },
