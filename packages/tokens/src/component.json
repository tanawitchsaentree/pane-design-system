{
  "card": {
    "bg": {
      "$type": "color",
      "$value": "{surface.glass}"
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "fg-muted": {
      "$type": "color",
      "$value": "{text.secondary}"
    },
    "blur": {
      "$type": "dimension",
      "$value": "{glass.blur}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.panel}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{gap.inset}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.xl}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{elevation.float}"
    },
    "rim-hi": {
      "$type": "color",
      "$value": "{line.rim-hi}"
    },
    "rim-mid": {
      "$type": "color",
      "$value": "{line.rim-mid}"
    },
    "rim-lo": {
      "$type": "color",
      "$value": "{line.rim-lo}"
    },
    "divider": {
      "$type": "color",
      "$value": "{line.divider}"
    },
    "rim-width": {
      "$type": "dimension",
      "$value": "{width.hairline}"
    },
    "inner-radius": {
      "$type": "dimension",
      "$value": "{corner.inner}"
    },
    "media-radius": {
      "$type": "dimension",
      "$value": "{corner.media}"
    },
    "cover-hi": {
      "$type": "color",
      "$value": "{surface.placeholder-hi}"
    },
    "cover-lo": {
      "$type": "color",
      "$value": "{surface.placeholder-lo}"
    },
    "brightness": {
      "$type": "number",
      "$value": "{glass.brightness}"
    },
    "sheen-top": {
      "$type": "color",
      "$value": "{surface.sheen-top}"
    },
    "sheen-bottom": {
      "$type": "color",
      "$value": "{surface.sheen-bottom}"
    },
    "text-halo": {
      "$type": "shadow",
      "$value": "{elevation.halo}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "the card is the pane itself: glass fill, sheen, rim, float shadow, panel corner and inset padding, each mapped from the material and depth roles so every pane is the same object"
      }
    }
  },
  "avatar": {
    "size-sm": {
      "$type": "dimension",
      "$value": "{control.avatar-sm}"
    },
    "size-md": {
      "$type": "dimension",
      "$value": "{control.avatar-md}"
    },
    "size-lg": {
      "$type": "dimension",
      "$value": "{control.avatar-lg}"
    },
    "ring": {
      "$type": "color",
      "$value": "{line.rim-hi}"
    },
    "ring-width": {
      "$type": "dimension",
      "$value": "{width.avatar-ring}"
    },
    "fallback-bg": {
      "$type": "color",
      "$value": "{surface.light}"
    },
    "fallback-fg": {
      "$type": "color",
      "$value": "{text.on-light}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "a person shown as a round object with a light rim so the face reads as lifted off the pane, at three sizes from the anchor card"
      }
    }
  },
  "button": {
    "light-bg": {
      "$type": "color",
      "$value": "{surface.light}"
    },
    "light-fg": {
      "$type": "color",
      "$value": "{text.on-light}"
    },
    "accent-bg": {
      "$type": "color",
      "$value": "{action.accent}"
    },
    "accent-bg-hover": {
      "$type": "color",
      "$value": "{action.accent-hover}"
    },
    "accent-fg": {
      "$type": "color",
      "$value": "{text.on-accent}"
    },
    "glass-bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "glass-fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "height-sm": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "height-md": {
      "$type": "dimension",
      "$value": "{control.lg}"
    },
    "padding-sm": {
      "$type": "dimension",
      "$value": "{gap.xl}"
    },
    "padding-md": {
      "$type": "dimension",
      "$value": "{gap.inset}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{elevation.lift}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P5",
        "why": "button roles: the loud solid, the blue promoted fill and the quiet glass fill, pill shaped and 44px tall so the one main action is unmistakable and easy to hit"
      }
    }
  },
  "icon-button": {
    "size": {
      "$type": "dimension",
      "$value": "{control.md}"
    },
    "size-sm": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "icon": {
      "$type": "dimension",
      "$value": "{control.icon-md}"
    },
    "glass-bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "ghost-fg": {
      "$type": "color",
      "$value": "{text.secondary}"
    },
    "blur": {
      "$type": "dimension",
      "$value": "{glass.blur-small}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "$extensions": {
      "kiln.why": {
        "p": [
          "P6",
          "P5"
        ],
        "why": "an icon-only control gets the same 44px target and quiet glass disc as secondary buttons, because it is never the loud action and must still be easy to hit"
      }
    }
  },
  "tabs": {
    "gap": {
      "$type": "dimension",
      "$value": "{gap.sm}"
    },
    "height": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "ring": {
      "$type": "color",
      "$value": "{line.ring}"
    },
    "on-bg": {
      "$type": "color",
      "$value": "{action.accent}"
    },
    "on-fg": {
      "$type": "color",
      "$value": "{text.on-accent}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P6",
        "why": "tab pills: the selected one is filled blue and also outlined, so selection is shown by shape as well as colour, and each pill is a full touch target"
      }
    }
  },
  "tag": {
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "ring": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{gap.xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P1",
        "why": "a label drawn as an outline only, so it marks content without adding another fill to a pane that already has its one loud thing"
      }
    }
  },
  "focus-ring": {
    "color": {
      "$type": "color",
      "$value": "{focus.ring}"
    },
    "halo": {
      "$type": "color",
      "$value": "{focus.halo}"
    },
    "width": {
      "$type": "dimension",
      "$value": "{width.ring}"
    },
    "halo-width": {
      "$type": "dimension",
      "$value": "{width.halo}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P6",
        "why": "one ring for every component: the text colour, 2px, offset, with a halo of the opposite colour so focus shows on any backdrop"
      }
    }
  },
  "grid": {
    "columns": {
      "$type": "number",
      "$value": "{layout.columns}"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "{layout.gutter}"
    },
    "margin": {
      "$type": "dimension",
      "$value": "{layout.margin}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "grid columns, gutters and spans read from the layout roles, so panes on a page share one set of edges at every breakpoint"
      }
    }
  },
  "container": {
    "margin": {
      "$type": "dimension",
      "$value": "{layout.margin}"
    },
    "max-sm": {
      "$type": "dimension",
      "$value": "{layout.container-sm}"
    },
    "max-md": {
      "$type": "dimension",
      "$value": "{layout.container-md}"
    },
    "max-lg": {
      "$type": "dimension",
      "$value": "{layout.container-lg}"
    },
    "max-xl": {
      "$type": "dimension",
      "$value": "{layout.container-xl}"
    },
    "max-2xl": {
      "$type": "dimension",
      "$value": "{layout.container-2xl}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P7",
        "why": "container widths and margins cap how wide content grows, so reading lines and grids stay a comfortable size on large screens"
      }
    }
  },
  "stack": {
    "gap-xs": {
      "$type": "dimension",
      "$value": "{gap.xs}"
    },
    "gap-sm": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "gap-md": {
      "$type": "dimension",
      "$value": "{gap.2xl}"
    },
    "gap-lg": {
      "$type": "dimension",
      "$value": "{gap.3xl}"
    },
    "gap-xl": {
      "$type": "dimension",
      "$value": "{gap.section}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P3",
        "why": "stack gaps come from the named gap scale, so spacing inside a pane always stays smaller than the pane padding around it"
      }
    }
  },
  "badge": {
    "positive-bg": {
      "$type": "color",
      "$value": "{status.positive}"
    },
    "warning-bg": {
      "$type": "color",
      "$value": "{status.warning}"
    },
    "critical-bg": {
      "$type": "color",
      "$value": "{status.critical}"
    },
    "info-bg": {
      "$type": "color",
      "$value": "{status.info}"
    },
    "positive-fg": {
      "$type": "color",
      "$value": "{status.on-positive}"
    },
    "warning-fg": {
      "$type": "color",
      "$value": "{status.on-warning}"
    },
    "critical-fg": {
      "$type": "color",
      "$value": "{status.on-critical}"
    },
    "info-fg": {
      "$type": "color",
      "$value": "{status.on-info}"
    },
    "neutral-bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "neutral-fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "neutral-ring": {
      "$type": "color",
      "$value": "{line.ring}"
    },
    "height": {
      "$type": "dimension",
      "$value": "{control.badge}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "dot": {
      "$type": "dimension",
      "$value": "{control.dot}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P6",
        "why": "status badges pair each status fill with its computed text colour and an optional dot, and always carry the status as words"
      }
    }
  },
  "chip": {
    "bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "ring": {
      "$type": "color",
      "$value": "{line.ring}"
    },
    "on-bg": {
      "$type": "color",
      "$value": "{surface.light}"
    },
    "on-fg": {
      "$type": "color",
      "$value": "{text.on-light}"
    },
    "height": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.sm}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "icon": {
      "$type": "dimension",
      "$value": "{control.icon-sm}"
    },
    "$extensions": {
      "kiln.why": {
        "p": "P6",
        "why": "chips are pressable pills; selected chips flip to the loud solid and gain a check mark, so the state is not shown by colour alone"
      }
    }
  },
  "banner": {
    "$extensions": {
      "kiln.why": {
        "p": [
          "P3",
          "P1"
        ],
        "why": "a banner is a line on the pane, not a box in it: tone marks are glyph colours only, a hairline separates it from the content, and spacing follows the pane"
      }
    },
    "mark-info": {
      "$type": "color",
      "$value": "{status.info-mark}"
    },
    "mark-positive": {
      "$type": "color",
      "$value": "{status.positive-mark}"
    },
    "mark-warning": {
      "$type": "color",
      "$value": "{status.warning-mark}"
    },
    "mark-critical": {
      "$type": "color",
      "$value": "{status.critical-mark}"
    },
    "glyph": {
      "$type": "dimension",
      "$value": "{control.icon-md}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "divider": {
      "$type": "color",
      "$value": "{line.divider}"
    },
    "dismiss": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "hit": {
      "$type": "dimension",
      "$value": "{layout.touch}"
    }
  },
  "select": {
    "trigger-bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "trigger-fg": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "trigger-ring": {
      "$type": "color",
      "$value": "{line.ring}"
    },
    "height-sm": {
      "$type": "dimension",
      "$value": "{control.sm}"
    },
    "height-md": {
      "$type": "dimension",
      "$value": "{control.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{gap.lg}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{corner.round}"
    },
    "menu-bg": {
      "$type": "color",
      "$value": "{surface.raised}",
      "$description": "opaque: a list over glass must not let the scene read through the options"
    },
    "menu-ring": {
      "$type": "color",
      "$value": "{line.divider}"
    },
    "menu-radius": {
      "$type": "dimension",
      "$value": "{corner.inner}"
    },
    "menu-shadow": {
      "$type": "shadow",
      "$value": "{elevation.float}"
    },
    "menu-min": {
      "$type": "dimension",
      "$value": "{control.menu-min}"
    },
    "item-hover": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "item-check": {
      "$type": "color",
      "$value": "{action.accent}"
    },
    "item-radius": {
      "$type": "dimension",
      "$value": "{corner.media}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.sm}"
    },
    "$extensions": {
      "kiln.why": {
        "p": [
          "P6",
          "P7"
        ],
        "why": "the closed control is a quiet pill on glass; the open list is opaque because options must never be read off a moving scene, with a check for the chosen one"
      }
    }
  },
  "slider": {
    "track": {
      "$type": "dimension",
      "$value": "{control.track}"
    },
    "track-bg": {
      "$type": "color",
      "$value": "{surface.quiet}"
    },
    "track-ring": {
      "$type": "color",
      "$value": "{line.ring}"
    },
    "range-bg": {
      "$type": "color",
      "$value": "{action.accent}"
    },
    "thumb": {
      "$type": "dimension",
      "$value": "{control.thumb}"
    },
    "thumb-bg": {
      "$type": "color",
      "$value": "{surface.knob}"
    },
    "thumb-shadow": {
      "$type": "shadow",
      "$value": "{elevation.lift}"
    },
    "hit": {
      "$type": "dimension",
      "$value": "{layout.touch}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{gap.xs}"
    },
    "$extensions": {
      "kiln.why": {
        "p": [
          "P6",
          "P4"
        ],
        "why": "a thin track with an accent range and a white knob that reads on both themes; the 44px hit area is kept even though the track is only 6px"
      }
    }
  }
}
