    },
    "fill-height": {
      "$value": "{control.xl}",
      "$type": "dimension",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P3",
            "P6"
          ],
          "why": "the bar is the target: 56px holds the label and value inside it and clears the 44px touch size"
        }
      }
    },
    "fill-radius": {
      "$value": "{corner.round}",
      "$type": "dimension",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P3"
          ],
          "why": "held in the hand, so a full pill like every other control"
        }
      }
    },
    "fill-padding": {
      "$value": "{gap.inset}",
      "$type": "dimension",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P3"
          ],
          "why": "label and value keep the field's inset from the curved ends"
        }
      }
    },
    "fill-bg": {
      "$value": "{surface.carve}",
      "$type": "color",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P1"
          ],
          "why": "the empty part is the same carve as a field, so in light the bar reads as a recess in the white pane and the white fill stands out from it"
        }
      }
    },
    "fill-carve": {
      "$value": "{elevation.groove}",
      "$type": "shadow",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P1"
          ],
          "why": "the bar is a groove like a field: shade under its top lip and the field's 3:1 edge all round"
        }
      }
    },
    "fill-top": {
      "$value": "{surface.chosen-top}",
      "$type": "color",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P1",
            "P5"
          ],
          "why": "the filled part is chosen glass, lighter than the well, lit from above"
        }
      }
    },
    "fill-foot": {
      "$value": "{surface.chosen-foot}",
      "$type": "color",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P1"
          ],
          "why": "the chosen glass fades toward its foot, one light from above"
        }
      }
    },
    "fill-rim": {
      "$value": "{line.rim-hi}",
      "$type": "color",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P1"
          ],
          "why": "the filled glass catches the light on its top edge"
        }
      }
    },
    "fill-marker": {
      "$value": "{action.loud-top}",
      "$type": "color",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P5"
          ],
          "why": "a thin bar in the loud solid (white in dark, ink in light) marks where the value ends, the one loud mark on the control"
        }
      }
    },
    "fill-marker-width": {
      "$value": "{width.bar}",
      "$type": "dimension",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P3"
          ],
          "why": "a 4px bar: a mark to read, while the whole control is the thing to grab"
        }
      }
    },
    "fill-marker-height": {
      "$value": "{control.check}",
      "$type": "dimension",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P3"
          ],
          "why": "the marker stands about half the bar's height"
        }
      }
    },
    "fill-marker-inset": {
      "$value": "{gap.lg}",
      "$type": "dimension",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P3"
          ],
          "why": "the marker sits just inside the end of the fill so it never touches the curve"
        }
      }
    },
    "range-glow": {
      "$value": "{glow.soft}",
      "$type": "shadow",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P1",
            "P5"
          ],
          "why": "the filled channel is a lit value, so in dark it gives off a soft light; in light it does not"
        }
      }
    },
    "fill-marker-glow": {
      "$value": "{glow.mark}",
      "$type": "shadow",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P1",
            "P5"
          ],
          "why": "the marker says where the value is now, so in dark it glows a little; in light it does not"
        }
      }
    },
    "min-width": {
      "$value": "{control.slider-min}",
      "$type": "dimension",
      "$extensions": {
        "kiln.why": {
          "p": [
            "P6",
            "P4"
          ],
          "why": "240px of travel at least, and the width never follows the value text, so nothing around it moves while dragging"
        }
      }
    }
  },
