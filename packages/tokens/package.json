{
  "name": "pane-tokens",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "description": "Pane design tokens — CSS custom properties, JSON, ESM (+types) and SCSS, built from DTCG in three tiers.",
  "license": "MIT",
  "exports": {
    "./css": {
      "types": "./css.d.ts",
      "default": "./build/css/tokens.css"
    },
    "./css/core": {
      "types": "./css.d.ts",
      "default": "./build/css/core.css"
    },
    "./css/colour": {
      "types": "./css.d.ts",
      "default": "./build/css/colour.css"
    },
    "./json": "./build/json/tokens.json",
    "./js": {
      "types": "./build/js/tokens.d.ts",
      "default": "./build/js/tokens.mjs"
    },
    "./scss": "./build/scss/_tokens.scss",
    "./package.json": "./package.json",
    "./css/brands/*": "./build/css/brands/*.css",
    "./brands.json": "./build/css/brands/brands.json",
    "./tailwind": "./build/tailwind/pane.preset.cjs",
    "./kotlin": "./build/kotlin/PaneTokens.kt",
    "./dart": "./build/dart/pane_tokens.dart",
    "./figma": "./build/figma/pane.variables.json",
    "./css/code-themes/*": "./build/css/code-themes/*.css",
    "./code-themes.json": "./build/css/code-themes/code-themes.json",
    "./brand-check": {
      "types": "./brand-check.d.mts",
      "default": "./brand-check.mjs"
    }
  },
  "files": [
    "build",
    "README.md",
    "css.d.ts",
    "brand-check.mjs",
    "brand-check.d.mts"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
