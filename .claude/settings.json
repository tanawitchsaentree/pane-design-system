{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit", "Write", "Read", "Glob", "Grep",
      "Bash(pnpm *)", "Bash(npm run *)", "Bash(node *)", "Bash(npx *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git status)", "Bash(git diff *)",
      "Bash(git log *)", "Bash(git stash *)", "Bash(git tag *)",
      "Bash(mkdir *)", "Bash(ls *)", "Bash(cat *)", "Bash(grep *)", "Bash(find *)"
    ],
    "deny": [
      "Bash(npm publish*)", "Bash(pnpm publish*)",
      "Bash(git push*)", "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node tooling/no-hardcode-lint.mjs || echo 'HOOK: no-hardcode lint FAILED — แก้ให้ผ่านก่อนไปต่อ'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -q 'system/DECISIONS.md'; then echo 'HOOK WARNING: กำลังแก้ system/DECISIONS.md — ต้องผ่าน skill lock-decision และประเมิน impact ก่อน'; fi"
          }
        ]
      }
    ]
  }
}
